#include <windows.h>
#include "res.h"

IDI_APPICON ICON "perch.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "Perch - network speed monitor"
            VALUE "FileVersion", "3.0.0"
            VALUE "InternalName", "Perch.exe"
            VALUE "OriginalFilename", "Perch.exe"
            VALUE "ProductName", "Perch"
            VALUE "ProductVersion", "3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
